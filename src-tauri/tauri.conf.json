{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noBS CAD",
  "version": "0.1.0",
  "identifier": "org.nbcad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "noBS CAD",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "backgroundColor": "#23262b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
