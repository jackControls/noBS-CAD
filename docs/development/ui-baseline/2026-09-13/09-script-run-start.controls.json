{"active_session_id":"1d2b830f-986c-4c7a-912a-c067efc44270","attached_session_id":"1d2b830f-986c-4c7a-912a-c067efc44270","presented":true,"request_id":"1789309162146-25576-0","session_id":"8098b9e7-2d74-4d34-ba83-d09dfbbbb392","state":{"active_tool":null,"mode":"solid","selected_body":null,"selected_edges":[],"selected_entities":[],"selected_face":null,"viewport":{"height":732,"width":820,"x":240,"y":120}},"status":"applied","ui":{"canvases":[{"height":732,"name":"viewport","width":820,"x":240,"y":120}],"document_visible":true,"focused_control":"control-11-79","surfaces":[{"controls":[{"disabled":false,"expanded":false,"id":"control-11-1","label":"File","role":"button","surface":"file-and-project-tabs"},{"disabled":false,"id":"control-11-2","label":"New design","role":"button","surface":"file-and-project-tabs"},{"disabled":false,"id":"control-11-3","label":"Untitled","role":"tab","selected":false,"surface":"file-and-project-tabs"},{"disabled":false,"id":"control-11-4","label":"Close document: Untitled","role":"button","surface":"file-and-project-tabs"},{"disabled":false,"id":"control-11-5","label":"Untitled — Double-click to rename project","role":"tab","selected":true,"surface":"file-and-project-tabs"},{"disabled":false,"id":"control-11-6","label":"Close document","role":"button","surface":"file-and-project-tabs"}],"name":"file-and-project-tabs"},{"controls":[{"disabled":false,"expanded":true,"id":"control-11-7","label":"Scripts","role":"button","surface":"document/scripts"},{"disabled":false,"id":"control-11-67","label":"Close scripts","role":"button","surface":"document/scripts"},{"disabled":true,"id":"control-11-68","label":"Open script…","role":"button","surface":"document/scripts"},{"disabled":false,"expanded":false,"id":"control-11-69","label":"Load from a file path","role":"button","surface":"document/scripts"},{"disabled":false,"id":"control-11-70","label":"Overview","role":"tab","selected":false,"surface":"document/scripts"},{"disabled":false,"id":"control-11-71","label":"Source","role":"tab","selected":true,"surface":"document/scripts"},{"disabled":true,"id":"control-11-72","label":"Source chapter","options":[{"disabled":false,"label":"Choose a chapter…","value":""},{"disabled":false,"label":"1. Locate the stock","value":"0"},{"disabled":false,"label":"6. Give the profile thickness","value":"1"},{"disabled":false,"label":"12. Round only the top rim","value":"2"},{"disabled":false,"label":"17. Change a feature, keep its dependants","value":"3"},{"disabled":false,"label":"24. Restore the 12 mm design","value":"4"},{"disabled":false,"label":"27. Three editable features","value":"5"}],"role":"select","surface":"document/scripts","value":""},{"disabled":false,"id":"control-11-73","label":"Script source","role":"textarea","selection":{"end":0,"start":0},"surface":"document/scripts","value":"// A first native part: dimensioned sketch → stock extrusion → top-edge roundover → edit and restore.\n// The same commands build the editable project, a visible lesson or isolated preview frames.\n// All dimensions are millimetres. Returned references locate geometry without recorded IDs.\n{\n  \"$schema\": \"./nbcad-script.schema.json\",\n  \"version\": 1,\n  \"name\": \"Sketch, extrude, ease the edges\",\n  \"starting_state\": \"empty\",\n  \"steps\": [\n    {\n      \"chapter\": \"Locate the stock\",\n      \"note\": \"Start from a marked face, edge and end. A 60 × 30 mm rectangle controls the footprint; one fixed corner locates it at the machining origin.\",\n      \"duration_ms\": 1100\n    },\n    {\n      \"id\": \"stock_sketch\",\n      \"call\": {\n        \"group\": \"sketch/draw\", \"operation\": \"sketch_begin\",\n        \"arguments\": {\"name\": \"Block / stock from A-B-C\", \"plane\": {\"type\": \"origin_plane\", \"plane\": \"xy\"}}\n      }\n    },\n    {\n      \"id\": \"stock_profile\",\n      \"call\": {\n        \"group\": \"sketch/draw\", \"operation\": \"sketch_add_rectangle_locked\",\n        \"arguments\": {\n          \"mode\": \"two_point\", \"anchor\": {\"x\": 0, \"y\": 0}, \"corner_hint\": {\"x\": 60, \"y\": 30},\n          \"width_mm\": 60, \"height_mm\": 30, \"ctrl_held\": true\n        }\n      }\n    },\n    {\n      \"id\": \"locate_profile\",\n      \"call\": {\n        \"group\": \"sketch/constrain\", \"operation\": \"sketch_add_constraint\",\n        \"arguments\": {\n          \"type\": \"fix\",\n          \"entity\": {\n            \"$select\": {\n              \"from\": {\"$ref\": \"stock_profile\", \"pointer\": \"/sketch\"}, \"path\": \"/entities\",\n              \"where\": {\"/kind\": \"point\", \"/position/x\": 0, \"/position/y\": 0},\n              \"take\": \"one\", \"pointer\": \"/id\"\n            }\n          }\n        }\n      }\n    },\n    {\"view\": \"current\", \"fit\": true, \"target\": \"active_sketch\", \"duration_ms\": 300},\n    {\n      \"chapter\": \"Give the profile thickness\",\n      \"note\": \"Extrude this closed profile by 12 mm. The sketch remains in the history, so width, depth and thickness can be edited independently.\",\n      \"duration_ms\": 1100\n    },\n    {\"id\": \"finish_stock_sketch\", \"call\": {\"group\": \"sketch/draw\", \"operation\": \"sketch_finish\", \"arguments\": {}}},\n    {\n      \"id\": \"stock_extrude\",\n      \"call\": {\n        \"group\": \"solid/build\", \"operation\": \"solid_extrude\",\n        \"arguments\": {\n          \"sketch_name\": \"Block / stock from A-B-C\", \"profile_indices\": [0], \"operation\": \"new_body\",\n          \"extent\": {\"type\": \"distance\", \"distance\": 12}, \"taper_angle_deg\": 0, \"flip\": false, \"target_body_ids\": []\n        }\n      }\n    },\n    {\n      \"let\": {\n        \"stock_feature\": {\n          \"$select\": {\"from\": {\"$ref\": \"stock_extrude\"}, \"path\": \"/document/features\", \"take\": \"last\", \"pointer\": \"/id\"}\n        }\n      }\n    },\n    {\n      \"let\": {\n        \"stock_body\": {\n          \"$select\": {\n            \"from\": {\"$ref\": \"stock_extrude\"}, \"path\": \"/scene/bodies\",\n            \"where\": {\"/feature_id\": {\"$ref\": \"stock_feature\"}}, \"take\": \"one\"\n          }\n        }\n      }\n    },\n    {\"view\": \"isometric\", \"fit\": true, \"body_id\": {\"$ref\": \"stock_body\", \"pointer\": \"/id\"}, \"duration_ms\": 350},\n    {\n      \"chapter\": \"Round only the top rim\",\n      \"note\": \"Select the four edges lying on the 12 mm top face. A 2 mm fillet softens the touched rim while the bottom remains a flat bearing face.\",\n      \"duration_ms\": 1400\n    },\n    // Select by geometric intent: all points on each chosen edge lie at the stock top.\n    // Count the result before applying the feature; unexpected topology stops the lesson.\n    {\n      \"let\": {\n        \"top_edges\": {\n          \"$select\": {\n            \"from\": {\"$ref\": \"stock_body\"}, \"path\": \"/edges\",\n            \"where\": {\"/refinable\": true, \"$every\": {\"path\": \"/points\", \"where\": {\"/z\": 12}}},\n            \"take\": \"all\", \"pointer\": \"/id\"\n          }\n        }\n      }\n    },\n    {\"assert\": {\"$count\": {\"$ref\": \"top_edges\"}}, \"equals\": 4},\n    {\n      \"id\": \"ease_top_edges\",\n      \"call\": {\n        \"group\": \"solid/refine\", \"operation\": \"solid_fillet\",\n        \"arguments\": {\n          \"body_id\": {\"$ref\": \"stock_body\", \"pointer\": \"/id\"}, \"edge_ids\":","value_length":8161,"value_start":0,"value_truncated":true},{"disabled":true,"id":"control-11-74","label":"Validate changes","role":"button","surface":"document/scripts"},{"disabled":true,"id":"control-11-75","label":"Save script as…","role":"button","surface":"document/scripts"},{"disabled":false,"expanded":false,"id":"control-11-76","label":"Browse 10 examples","role":"button","surface":"document/scripts"},{"disabled":true,"id":"control-11-77","label":"Script run mode","options":[{"disabled":false,"label":"Presentation","value":"present"},{"disabled":false,"label":"Maximum speed","value":"fast"}],"role":"select","surface":"document/scripts","value":"present"},{"disabled":true,"id":"control-11-78","label":"Script speed","options":[{"disabled":false,"label":"0.25×","value":"0.25"},{"disabled":false,"label":"0.5×","value":"0.5"},{"disabled":false,"label":"1×","value":"1"},{"disabled":false,"label":"2×","value":"2"},{"disabled":false,"label":"4×","value":"4"},{"disabled":false,"label":"8×","value":"8"},{"disabled":false,"label":"16×","value":"16"}],"role":"select","surface":"document/scripts","value":"2"},{"disabled":false,"id":"control-11-79","label":"Stop script","role":"button","surface":"document/scripts"}],"name":"document/scripts"},{"controls":[{"disabled":false,"expanded":false,"id":"control-11-8","label":"Switch workspace","role":"button","surface":"ribbon"}],"name":"ribbon"},{"controls":[{"disabled":false,"id":"control-11-9","label":"Create Sketch","role":"button","surface":"solid/profile"},{"disabled":true,"id":"control-11-10","label":"PROFILE","role":"button","surface":"solid/profile"}],"name":"solid/profile"},{"controls":[{"disabled":false,"expanded":false,"id":"control-11-11","label":"Extrude","role":"button","surface":"solid/build"},{"disabled":false,"id":"control-11-12","label":"Revolve","role":"button","surface":"solid/build"},{"disabled":false,"id":"control-11-13","label":"Sweep","role":"button","surface":"solid/build"},{"disabled":false,"id":"control-11-14","label":"Loft","role":"button","surface":"solid/build"},{"disabled":false,"id":"control-11-15","label":"Rib","role":"button","surface":"solid/build"},{"disabled":false,"id":"control-11-16","label":"BUILD","role":"button","surface":"solid/build"}],"name":"solid/build"},{"controls":[{"disabled":false,"id":"control-11-17","label":"Hole","role":"button","surface":"solid/refine"},{"disabled":false,"id":"control-11-18","label":"External Thread","role":"button","surface":"solid/refine"},{"disabled":false,"expanded":false,"id":"control-11-19","label":"Fillet"