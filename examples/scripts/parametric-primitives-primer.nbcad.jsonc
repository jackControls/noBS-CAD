// Hello parametric API: sketch → extrude → hole → combine cut → fillet → chamfer → datum → 3MF.
// Minimal lesson — not a flagship. All dimensions millimetres. Prefer $select over recorded IDs.
{
  "$schema": "./nbcad-script.schema.json",
  "version": 1,
  "name": "Parametric primitives primer",
  "starting_state": "empty",
  "steps": [
    {
      "chapter": "Stock profile",
      "note": "40 × 30 mm rectangle fixed at the origin on XY.",
      "duration_ms": 600
    },
    {
      "id": "stock_sketch",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Primer / stock",
          "plane": {"type": "origin_plane", "plane": "xy"}
        }
      }
    },
    {
      "id": "stock_profile",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {"x": 0, "y": 0},
          "corner_hint": {"x": 40, "y": 30},
          "width_mm": 40,
          "height_mm": 30,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "locate_stock",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {"$ref": "stock_profile", "pointer": "/sketch"},
              "path": "/entities",
              "where": {"/kind": "point", "/position/x": 0, "/position/y": 0},
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {"id": "finish_stock", "call": {"group": "sketch/draw", "operation": "sketch_finish", "arguments": {}}},
    {
      "id": "stock_extrude",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Primer / stock",
          "profile_indices": [0],
          "operation": "new_body",
          "extent": {"type": "distance", "distance": 8},
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "stock_feature": {
          "$select": {
            "from": {"$ref": "stock_extrude"},
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "let": {
        "stock_body": {
          "$select": {
            "from": {"$ref": "stock_extrude"},
            "path": "/scene/bodies",
            "where": {"/feature_id": {"$ref": "stock_feature"}},
            "take": "one"
          }
        }
      }
    },
    {
      "chapter": "Through hole",
      "note": "One Ø5 through hole on the +Z face, projected from part coordinates.",
      "duration_ms": 600
    },
    {
      "let": {
        "top_face": {
          "$select": {
            "from": {
              "$select": {
                "from": {"$ref": "stock_extrude"},
                "path": "/scene/bodies",
                "where": {"/id": {"$ref": "stock_body", "pointer": "/id"}},
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {"/plane/normal/2": 1},
            "take": "one"
          }
        }
      }
    },
    {
      "id": "center_hole",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {"$ref": "stock_body", "pointer": "/id"},
          "face_id": {"$ref": "top_face", "pointer": "/id"},
          "position": {
            "$project": {
              "point": [20, 15, 8],
              "basis": {"$ref": "top_face", "pointer": "/plane"}
            }
          },
          "diameter": 5,
          "extent": {"type": "through_all"},
          "style": "simple",
          "counterbore_diameter": 0,
          "counterbore_depth": 0,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false
        }
      }
    },
    {
      "chapter": "Combine cut",
      "note": "Second body overlaps a corner; cut it from the stock with solid_combine.",
      "duration_ms": 600
    },
    {
      "id": "tool_sketch",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Primer / cut tool",
          "plane": {"type": "origin_plane", "plane": "xy"}
        }
      }
    },
    {
      "id": "tool_profile",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {"x": 28, "y": 18},
          "corner_hint": {"x": 40, "y": 30},
          "width_mm": 12,
          "height_mm": 12,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "locate_tool",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {"$ref": "tool_profile", "pointer": "/sketch"},
              "path": "/entities",
              "where": {"/kind": "point", "/position/x": 28, "/position/y": 18},
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {"id": "finish_tool", "call": {"group": "sketch/draw", "operation": "sketch_finish", "arguments": {}}},
    {
      "id": "tool_extrude",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Primer / cut tool",
          "profile_indices": [0],
          "operation": "new_body",
          "extent": {"type": "distance", "distance": 8},
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "tool_feature": {
          "$select": {
            "from": {"$ref": "tool_extrude"},
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "let": {
        "tool_body": {
          "$select": {
            "from": {"$ref": "tool_extrude"},
            "path": "/scene/bodies",
            "where": {"/feature_id": {"$ref": "tool_feature"}},
            "take": "one"
          }
        }
      }
    },
    {
      "id": "cut_corner",
      "call": {
        "group": "solid/body",
        "operation": "solid_combine",
        "arguments": {
          "target_body_id": {"$ref": "stock_body", "pointer": "/id"},
          "tool_body_ids": [{"$ref": "tool_body", "pointer": "/id"}],
          "operation": "cut",
          "keep_tools": false
        }
      }
    },
    {
      "let": {
        "part_body": {
          "$select": {
            "from": {"$ref": "cut_corner"},
            "path": "/scene/bodies",
            "where": {"/id": {"$ref": "stock_body", "pointer": "/id"}},
            "take": "one"
          }
        }
      }
    },
    {
      "chapter": "Fillet and chamfer",
      "note": "Round remaining top rim edges; chamfer one bottom edge.",
      "duration_ms": 600
    },
    {
      "let": {
        "top_edges": {
          "$select": {
            "from": {"$ref": "part_body"},
            "path": "/edges",
            "where": {
              "/refinable": true,
              "$every": {"path": "/points", "where": {"/z": 8}}
            },
            "take": "all",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "fillet_top",
      "call": {
        "group": "solid/refine",
        "operation": "solid_fillet",
        "arguments": {
          "body_id": {"$ref": "part_body", "pointer": "/id"},
          "edge_ids": {"$ref": "top_edges"},
          "radius": 1.5,
          "tangent_chain": false
        }
      }
    },
    {
      "let": {
        "bottom_edge": {
          "$select": {
            "from": {
              "$select": {
                "from": {"$ref": "fillet_top"},
                "path": "/scene/bodies",
                "where": {"/id": {"$ref": "part_body", "pointer": "/id"}},
                "take": "one"
              }
            },
            "path": "/edges",
            "where": {
              "/refinable": true,
              "$every": {"path": "/points", "where": {"/z": 0}}
            },
            "take": "first",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "chamfer_bottom",
      "call": {
        "group": "solid/refine",
        "operation": "solid_chamfer",
        "arguments": {
          "body_id": {"$ref": "part_body", "pointer": "/id"},
          "edge_ids": [{"$ref": "bottom_edge"}],
          "distance": 0.8,
          "tangent_chain": false
        }
      }
    },
    {
      "chapter": "Datum and export",
      "note": "Offset XY by 4 mm, then inspect and export 3MF.",
      "duration_ms": 600
    },
    {
      "id": "mid_height_datum",
      "call": {
        "group": "solid/reference",
        "operation": "construction_plane_offset",
        "arguments": {
          "name": "Primer / mid height",
          "offset": 4,
          "reference": {"type": "origin_plane", "plane": "xy"}
        }
      }
    },
    {
      "id": "inspect",
      "call": {"group": "solid/check", "operation": "solid_scene", "arguments": {}},
      "expect": {"/errors": []}
    },
    {
      "id": "export_3mf",
      "call": {
        "group": "document/export",
        "operation": "solid_export_3mf",
        "arguments": {
          "body_ids": [{"$ref": "part_body", "pointer": "/id"}],
          "slicer_target": "standard"
        }
      }
    }
  ],
  "checks": [
    {"id": "final_scene", "call": {"group": "solid/check", "operation": "solid_scene", "arguments": {}}, "expect": {"/errors": []}},
    {"assert": {"$count": {"$ref": "final_scene", "pointer": "/bodies"}}, "equals": 1},
    {"id": "final_model", "call": {"group": "document/files", "operation": "cad_project_model", "arguments": {}}},
    {"assert": {"$count": {"$ref": "final_model", "pointer": "/document/history/features"}}, "equals": 9}
  ],
  "exports": {
    "final_model": {"$ref": "final_model"},
    "final_scene": {"$ref": "final_scene"}
  }
}
